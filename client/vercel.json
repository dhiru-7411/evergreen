{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://evergreen-api-qvez.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://evergreen-api-qvez.onrender.com/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://evergreen-api-qvez.onrender.com/api/robots.txt"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|LinkedInBot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|SkypeUriPreview|redditbot|Pinterest|Embedly|Applebot|BingPreview|Mastodon|Bluesky|Google-InspectionTool).*"
        }
      ],
      "destination": "https://evergreen-api-qvez.onrender.com/api/og?path=/"
    },
    {
      "source": "/:path((?!assets/|og-default\\.png|favicon\\.svg).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|LinkedInBot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|SkypeUriPreview|redditbot|Pinterest|Embedly|Applebot|BingPreview|Mastodon|Bluesky|Google-InspectionTool).*"
        }
      ],
      "destination": "https://evergreen-api-qvez.onrender.com/api/og?path=/:path"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
