PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/evergreen
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# How often posts are re-checked against the npm registry
FRESHNESS_INTERVAL_HOURS=12

# AI features (learning paths, accuracy checks). Optional: without a key they're disabled.
# Create a key at console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5    # claude-haiku-5-5 is much cheaper, somewhat lower quality
# AI_EFFORT=high              # low | medium | high | xhigh | max

# Account emails (verification, password reset). Optional: without SMTP_URL,
# emails are printed to this server's log and verification isn't enforced.
# Free options: Brevo (300/day, no domain needed), or Gmail with an app password.
# SMTP_URL=smtps://LOGIN:SMTP_KEY@smtp-relay.brevo.com:465
# MAIL_FROM="Evergreen <you@example.com>"
# APP_URL=http://localhost:5173        # public site address used in email links
# REQUIRE_EMAIL_VERIFICATION=true      # defaults to true when SMTP_URL is set
# TRUST_PROXY=1                        # proxies in front of the app (2 behind Vercel -> Render)
