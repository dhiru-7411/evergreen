PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/evergreen
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# How often posts are re-checked against the npm registry
FRESHNESS_INTERVAL_HOURS=12

# AI features (learning paths, accuracy checks). Optional: without a key they're disabled.
# Create a key at console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5    # claude-haiku-5-5 is much cheaper, somewhat lower quality
# AI_EFFORT=high              # low | medium | high | xhigh | max
